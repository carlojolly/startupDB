# Copy this file to .env and fill in your own connection string:
#     cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 5432) and replace [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Neon -------------------------------------------------------------------
# Dashboard -> your project -> Connection Details -> copy the connection string.
# Keep the ?sslmode=require on the end.
# DATABASE_URL=postgresql://user:password@ep-something-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=
